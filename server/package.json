{
  "name": "cdc-dashboard-api",
  "version": "1.0.0",
  "description": "Ingest + query API backing the CDC dashboards with MongoDB (Tally automation pipeline).",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "init": "node init_db.js",
    "load": "node loader.js",
    "test:logic": "node test_e2e_fake.js",
    "test:voucher": "node test_voucher_details.js",
    "test:sync": "node test_sync_fake.js && node test_sync_guards_fake.js",
    "test:backfill": "node test_backfill_fake.js",
    "test:reset": "node test_reset_fake.js",
    "test:meta": "node test_meta_api_fake.js",
    "test:alias": "node test_alias_suggest_fake.js",
    "test:yoy": "node test_yoy_fake.js && node test_yoy_api_fake.js && node test_yoy_tree_fake.js && node test_yoy_tree_api_fake.js && node test_yoy_party_fake.js",
    "test:db": "node test_e2e.js",
    "test:browser": "node test_browser.js && node test_browser_proj.js",
    "test:browser:alias": "node test_browser_alias.js",
    "test:browser:yoy": "node test_browser_yoy.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "mongodb": "^6.8.0"
  },
  "devDependencies": {
    "playwright-core": "^1.61.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
